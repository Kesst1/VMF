# Vercel / Next.js website environment variables.
# Replace placeholders in Vercel settings; do not commit real secrets.
DATABASE_URL=YOUR_NEON_POSTGRES_CONNECTION_STRING
ADMIN_API_KEY=GENERATE_A_PRIVATE_RANDOM_SECRET
ADMIN_SESSION_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_OAUTH_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://vmf-drab.vercel.app/api/admin/auth/callback
DISCORD_BOT_TOKEN=YOUR_PRIVATE_DISCORD_BOT_TOKEN
ROBLOX_CLIENT_ID=YOUR_ROBLOX_OAUTH_CLIENT_ID
ROBLOX_CLIENT_SECRET=YOUR_ROBLOX_OAUTH_CLIENT_SECRET
ROBLOX_REDIRECT_URI=YOUR_REGISTERED_ROBLOX_CALLBACK_URL
